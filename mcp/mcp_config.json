{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "CONTEXT7-API-KEY"
      ]
    },
    "azure-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@azure/mcp@latest",
        "server",
        "start"
      ],
      "disabledTools": [
        "aks",
        "managedlustre",
        "eventgrid",
        "acr",
        "cosmos",
        "bicepschema",
        "eventhubs",
        "loadtesting",
        "kusto",
        "grafana",
        "signalr",
        "subscription_list",
        "group_list",
        "workbooks",
        "virtualdesktop",
        "servicebus",
        "speech",
        "communication",
        "redis",
        "postgres",
        "monitor",
        "quota",
        "marketplace",
        "confidentialledger"
      ]
    },
    "deepwiki": {
      "serverUrl": "https://mcp.deepwiki.com/sse"
    },
    "github": {
      "serverUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer GITHUB-PERSONAL-ACCESS-TOKEN"
      },
      "disabled": true
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "fabric-mcp-server": {
      "command": "npx",
      "args": [
        "-y",
        "@microsoft/fabric-mcp@latest",
        "server",
        "start",
        "--mode",
        "all"
      ]
    }
  }
}